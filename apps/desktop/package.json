{
  "name": "@jobautomation/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for JobAutomation",
  "author": "Amro212",
  "type": "module",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"corepack pnpm dev:renderer\" \"corepack pnpm dev:main\" \"corepack pnpm dev:preload\" \"corepack pnpm dev:electron\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "node scripts/build-preload.mjs --watch",
    "dev:electron": "wait-on tcp:5174 file:dist/main/main/index.js file:dist/main/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron . --remote-debugging-port=9222",
    "build": "corepack pnpm build:renderer && corepack pnpm build:main && corepack pnpm build:api && node scripts/run-electron-builder.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json && node scripts/build-preload.mjs",
    "build:win": "corepack pnpm build -- --win",
    "build:mac": "corepack pnpm build -- --mac"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@jobautomation/core": "workspace:*",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "camoufox-js": "^0.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "node-cron": "^4.2.1",
    "node-html-parser": "^7.1.0",
    "p-queue": "^9.0.0",
    "playwright": "^1.52.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "resedit": "^1.7.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "wait-on": "^8.0.5"
  }
}

{
  "name": "@jobautomation/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for JobAutomation",
  "author": "Amro212",
  "type": "module",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"corepack pnpm dev:renderer\" \"corepack pnpm dev:main\" \"corepack pnpm dev:preload\" \"corepack pnpm dev:electron\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "node scripts/build-preload.mjs --watch",
    "dev:electron": "wait-on tcp:5174 file:dist/main/main/index.js file:dist/main/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron . --remote-debugging-port=9222",
    "build": "corepack pnpm build:renderer && corepack pnpm build:main && corepack pnpm build:api && node scripts/run-electron-builder.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json && node scripts/build-preload.mjs",
    "build:win": "corepack pnpm build -- --win",
    "build:mac": "corepack pnpm build -- --mac"
  },
  "dependencies": {
    "@jobautomation/core": "workspace:*",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.3.0",
    "camoufox-js": "^0.10.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "node-cron": "^4.2.1",
    "node-html-parser": "^7.1.0",
    "p-queue": "^9.0.0",
    "playwright": "^1.52.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.1.12",
    "wait-on": "^8.0.5"
  }
}

API_HOST=127.0.0.1
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
DASHBOARD_PORT=3000
GREENHOUSE_API_BASE_URL=https://boards-api.greenhouse.io/v1/boards
LEVER_API_BASE_URL=https://api.lever.co/v0/postings
ASHBY_API_BASE_URL=https://api.ashbyhq.com/posting-api/job-board
DISCOVERY_SCHEDULE_CRON=0 */6 * * *
DISCOVERY_SCHEDULE_TIMEZONE=America/Toronto
DISCOVERY_QUEUE_CONCURRENCY=1
JOB_AUTOMATION_DB_PATH=./data/jobautomation.sqlite
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_JOB_SUMMARY_MODEL=google/gemini-2.0-flash-lite-001
# Set to 1 to run application (apply) automation with a visible Camoufox browser window for debugging.
JOBAUTOMATION_APPLICATION_BROWSER_HEADED=
# When headed, the Camoufox browser window stays open after pause so you can finish custom questions in the same session.
# Set to 1 to close the browser immediately after pause (scripts/CI).
JOBAUTOMATION_APPLICATION_AUTO_CLOSE_BROWSER=
# Comma-separated domain allowlist for browser automation targets (supports exact domains and *.wildcards).
# Example: JOBAUTOMATION_AUTHORIZED_DOMAIN_ALLOWLIST=example.com,*.careers.example.com
JOBAUTOMATION_AUTHORIZED_DOMAIN_ALLOWLIST=
# Set to 1 to fail all browser automation runs when the allowlist is empty.
JOBAUTOMATION_AUTHORIZED_DOMAIN_STRICT=
# Optional polling jitter bounds (ms) for form readiness checks.
JOBAUTOMATION_APPLICATION_POLL_MIN_MS=
JOBAUTOMATION_APPLICATION_POLL_MAX_MS=

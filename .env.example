API_HOST=127.0.0.1
API_PORT=3001
API_BASE_URL=http://127.0.0.1:3001
DASHBOARD_PORT=3000
GREENHOUSE_API_BASE_URL=https://boards-api.greenhouse.io/v1/boards
LEVER_API_BASE_URL=https://api.lever.co/v0/postings
ASHBY_API_BASE_URL=https://api.ashbyhq.com/posting-api/job-board
DISCOVERY_SCHEDULE_CRON=0 */6 * * *
DISCOVERY_SCHEDULE_TIMEZONE=America/Toronto
DISCOVERY_QUEUE_CONCURRENCY=1
JOB_AUTOMATION_DB_PATH=./data/jobautomation.sqlite
# Google Oauth Credentials
JOBAUTOMATION_GREENHOUSE_EMAIL_VERIFICATION_ENABLED=1
JOBAUTOMATION_GMAIL_USER_EMAIL=your-email@example.com
JOBAUTOMATION_GMAIL_CLIENT_ID=your-google-oauth-client-id
JOBAUTOMATION_GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
JOBAUTOMATION_GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
# OpenRouter API Credentials
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_JOB_SUMMARY_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_APPLICATION_FILL_PLAN_MODEL=google/gemini-2.5-flash-lite
# Set to 1 to run application (apply) Playwright with a visible browser window for debugging.
JOBAUTOMATION_APPLICATION_BROWSER_HEADED=1
# When headed, the Chromium window stays open after pause so you can finish custom questions in the same session.
# Set to 1 to close the browser immediately after pause (scripts/CI).
JOBAUTOMATION_APPLICATION_AUTO_CLOSE_BROWSER=0
# Comma-separated domain allowlist for browser automation targets (supports exact domains and *.wildcards).
# Example: JOBAUTOMATION_AUTHORIZED_DOMAIN_ALLOWLIST=example.com,*.careers.example.com
# JOBAUTOMATION_AUTHORIZED_DOMAIN_ALLOWLIST=jobs.ashbyhq.com,job-boards.greenhouse.io,jobs.lever.co
# Set to 1 to fail all browser automation runs when the allowlist is empty.
JOBAUTOMATION_AUTHORIZED_DOMAIN_STRICT=
# Optional polling jitter bounds (ms) for form readiness checks.
JOBAUTOMATION_APPLICATION_POLL_MIN_MS=
JOBAUTOMATION_APPLICATION_POLL_MAX_MS=
# Vitest variables
# Opt-in live job board verification. These tests fill real postings and stop before submit.
JOBAUTOMATION_LIVE_JOB_BOARD_TESTS=1
JOBAUTOMATION_LIVE_GREENHOUSE_JOB_URL=https://job-boards.greenhouse.io/example/jobs/job-id
JOBAUTOMATION_LIVE_ASHBY_JOB_URL=https://jobs.ashbyhq.com/example/job-id
JOBAUTOMATION_LIVE_LEVER_JOB_URL=https://jobs.lever.co/example/job-id
# Set to 1 to watch the live verification browser.
JOBAUTOMATION_LIVE_JOB_BOARD_HEADED=1

# Groq API key
GROQ_API_KEY=your-groq-api-key
